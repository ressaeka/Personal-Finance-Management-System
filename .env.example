PORT=3000
NODE_ENV=development

# JWT
JWT_SECRET=ubah_dengan_string_random_yang_panjang
JWT_REFRESH_SECRET=ubah_dengan_string_random_lain
JWT_RESET_SECRET=ubah_dengan_string_random_lain_lagi
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS (pisahkan dengan koma)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Prisma - Supabase
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/postgres"
DATABASE_URL_TEST="postgresql://postgres:admin@localhost:5432/db_test"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=email@gmail.com
SMTP_PASS=app_password

# Frontend URL untuk link reset password
FRONTEND_URL=http://localhost:5173
